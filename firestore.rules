rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: read/write own document only
    // Client CANNOT change: coins, gems, adsRemoved, glamPassUntil, palette completion flags, unlockedLooks, purchases
    // These fields are server-write-only (Cloud Functions)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['displayName', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20
        && !request.resource.data.displayName.matches('.*[<>"\'/].*');
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['coins', 'gems', 'adsRemoved', 'glamPassUntil', 'unlockedLooks', 'purchases']);
    }
    
    // Scores: creatable by signed-in owner with valid schema, read-only for leaderboard
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.mode in ['free', 'daily']
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'score', 'mode', 'createdAt']);
      allow update, delete: if false;
    }
    
    // Daily Brief: read-only for clients
    match /dailyBrief/{date} {
      allow read: if request.auth != null;
      allow write: if false; // server only
    }
    
    // Purchases: read own only, write server only
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
