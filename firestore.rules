rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Create new user record
      allow create: if isOwner(userId)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.marketingConsent is bool;

      // Update existing user: client cannot modify coins, gems, adsRemoved, glamPassUntil directly
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'gems', 'adsRemoved', 'glamPassUntil']);

      allow delete: if isOwner(userId);
    }

    // Scores collection (Weekly Leaderboard)
    match /scores/{scoreId} {
      // Read-only for any authenticated user
      allow read: if isAuthenticated();

      // Only signed-in owner can submit their score with a valid schema
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 500000
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.week is string;

      allow delete: if false; // Scores cannot be deleted by clients
    }

    // Purchases collection (Google Play & Digital Goods verification)
    match /purchases/{purchaseId} {
      // Users can only view their own validated purchases
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Clients cannot write or manipulate purchase records; server-only
      allow write: if false;
    }
  }
}
